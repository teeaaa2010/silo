# Single source of truth for pinned versions. Sourced by scripts/*.
# Nomad: verify the current stable release at https://releases.hashicorp.com/nomad/
NOMAD_VERSION=1.10.5
# Silo image (Docker Hub: pgsty/silo). Tag must be an immutable RELEASE.* tag.
SILO_IMAGE_REPO=docker.io/pgsty/silo
SILO_TAG=RELEASE.2026-08-06T00-00-00Z
# Filled in by scripts/pin-silo.sh (needs internet + docker). Format: sha256:<64 hex>
SILO_DIGEST=
# Helper image used by the privileged-driver check
BUSYBOX_IMAGE=busybox:1.36.1
